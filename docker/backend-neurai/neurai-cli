#!/usr/bin/env bash
# neurai-cli wrapper using the runtime config generated by the entrypoint.
# Usage inside the container / via compose:
#   docker compose exec backend-neurai neurai-cli getblockchaininfo
exec "${NEURAI_INSTALL_DIR:-/opt/coins/nodes/neurai}/neurai-cli" \
    -conf="${NEURAI_RUN_DIR:-/run/neurai}/neurai.conf" \
    -datadir="${NEURAI_DATA_DIR:-/opt/coins/data/neurai/backend}" "$@"
